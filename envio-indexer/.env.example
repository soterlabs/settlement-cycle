# HyperSync works WITHOUT any key. Set a token only if you hit the public
# rate limit or use a hosted HyperSync endpoint (envio.dev → API tokens).
# ENVIO_API_TOKEN=

# Local Postgres/Hasura ports are managed by `envio dev`; override only if the
# defaults (5433 / 8080) collide with something else on the box.
# ENVIO_PG_PORT=5433
# HASURA_GRAPHQL_PORT=8080
